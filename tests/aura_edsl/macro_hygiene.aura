;; Aura 宏卫生 / 展开性能探针（aura-memory-runtime EDSL 生产化验证）。期望值写在每个 probe 的标签里。
(define (probe tag th) (display tag) (display " => ") (display (try (th) (catch (e) (list 'caught (format "~a" e))))) (newline))
(define t 5)
(define-hygienic-macro (or2-h a b) (let ((t a)) (if t t b)))
(probe "hygienic-capture(expect 5)" (lambda () (or2-h #f t)))
(probe "hygienic-normal(expect 3)" (lambda () (or2-h #f 3)))
(define tmp 1) (define yy 2)
(define-hygienic-macro (swap-h! x y) (let ((tmp x)) (set! x y) (set! y tmp)))
(probe "hygienic-swap(expect (2 1))" (lambda () (swap-h! tmp yy) (list tmp yy)))
(define p1 1) (define q1 2)
(probe "hygienic-swap-nocollide(expect (2 1))" (lambda () (swap-h! p1 q1) (list p1 q1)))
(define-hygienic-macro (when-h c body) (if c body #f))
(probe "hygienic-shadow-if(expect 7)" (lambda () (let ((if (lambda (a b c) 'shadowed))) (when-h #t 7))))
(probe "hygienic-arity-msg" (lambda () (or2-h 1)))
(define t3 (current-time-ms))
(let loop ((i 0) (acc 0)) (if (< i 20000) (loop (+ i 1) (+ acc (or2-h #f i))) (display (list 'hyg-20000-ms (- (current-time-ms) t3) acc))))
(newline)
(define t4 (current-time-ms))
(let loop ((i 0) (acc 0)) (if (< i 20000) (loop (+ i 1) (+ acc (let ((t #f)) (if t t i)))) (display (list 'inline-20000-ms (- (current-time-ms) t4) acc))))
(newline)
